{
  "name": "pawnmanagers",
  "version": "1.2.0",
  "description": "Pawn Manager Application",
  "private": true,
  "type": "module",
  "main": "electron-main.cjs",
  "author": "Nguyen Hai Ha",
  "scripts": {
    "dev:front": "vite",
    "dev:back": "node ./backend/index.js",
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:back\"",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev:front\" \"npm run dev:back\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:publish": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.pawnmanager.app",
    "productName": "PawnManager",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "backend/**/*",
      "!backend/data/*.db",
      "electron-main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nguyen-Hai-Ha",
        "repo": "PawnManager",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@emailjs/nodejs": "^5.0.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "body-parser": "^2.2.2",
    "bootstrap": "^5.3.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.20",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pinia": "^3.0.4",
    "read-vietnamese-number": "^2.3.1",
    "v-money3": "^3.24.1",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.1",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "wait-on": "^9.0.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
